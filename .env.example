# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_screener
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10

# Networking & Ingestion
# SEC EDGAR mandates a User-Agent in the format: Sample Company Name AdminContact@<sample company domain>.com
SEC_USER_AGENT=StockScreener admin@example.com
REQUEST_TIMEOUT=15
WORKER_CONCURRENCY=8
RATE_LIMIT_PER_SEC=8.0

# Fundamental Analysis & Screening
DATA_MAX_AGE_DAYS=30
